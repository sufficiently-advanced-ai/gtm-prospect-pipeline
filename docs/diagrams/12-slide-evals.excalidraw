      "locked": false,
      "fontSize": 21,
      "fontFamily": 2,
      "text": "Mistakes become fixtures",
      "originalText": "Mistakes become fixtures",
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "t-643",
      "type": "text",
      "x": 570,
      "y": 671.125,
      "width": 460,
