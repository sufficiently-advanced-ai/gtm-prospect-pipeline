      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "fontSize": 16,
      "fontFamily": 2,
      "text": "The production error rate is the flip rate: how often\nthe human-verified pass overturns the automated call.\nSuite green while flips climb = a gap the fixtures\ndon't cover yet.",
      "originalText": "The production error rate is the flip rate: how often the human-verified pass overturns the automated call. Suite green while flips climb = a gap the fixtures don't cover yet.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "t-648",
