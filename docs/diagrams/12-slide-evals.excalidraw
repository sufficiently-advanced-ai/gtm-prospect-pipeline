      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "fontSize": 16,
      "fontFamily": 2,
      "text": "Capture-first means the inputs to every past decision\nare already frozen. A new failure is scaffolded into\na fixture, labeled by hand, and guarded from then on.",
      "originalText": "Capture-first means the inputs to every past decision are already frozen. A new failure is scaffolded into a fixture, labeled by hand, and guarded from then on.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
