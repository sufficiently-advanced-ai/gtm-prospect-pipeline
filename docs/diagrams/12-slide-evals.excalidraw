      "updated": 1,
      "link": null,
      "locked": false,
      "fontSize": 16,
      "fontFamily": 2,
      "text": "The pre-edit gate replays committed model responses:\nno credits, no network, seconds. It runs before every\nchange to the rulebook.",
      "originalText": "The pre-edit gate replays committed model responses: no credits, no network, seconds. It runs before every change to the rulebook.",
