      "updated": 1,
      "link": null,
      "locked": false,
      "fontSize": 16,
      "fontFamily": 2,
      "text": "Every API response and browser session is written to\nraw/ verbatim before anything reads meaning into it.\nAny conclusion can be traced back to the bytes it\ncame from — and the whole derived layer can be\nrebuilt.",
      "originalText": "Every API response and browser session is written to raw/ verbatim before anything reads meaning into it. Any conclusion can be traced back to the bytes it came from — and the whole derived layer can be rebuilt.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
