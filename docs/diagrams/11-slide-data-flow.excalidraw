      "updated": 1,
      "link": null,
      "locked": false,
      "fontSize": 16,
      "fontFamily": 2,
      "text": "A stage may only act on what the previous stage\ndurably wrote. Verification that didn't happen leaves\nthe account parked — no enrollment gets to assume it.",
      "originalText": "A stage may only act on what the previous stage durably wrote. Verification that didn't happen leaves the account parked — no enrollment gets to assume it.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
